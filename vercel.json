{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"functions": {
		"app/api/generate.ts": {
			"experimentalTriggers": [{ "type": "schedule/v1beta" }]
		}
	},
	"schedules": {
		"generate": {
			"schedule": "0 0 * * *",
			"function": "api/generate",
			"timezone": "Pacific/Kiritimati"
		}
	}
}
