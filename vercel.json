{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"schedules": {
		"generate": {
			"schedule": "1 0 * * *",
			"function": "api/generate",
			"timezone": "Pacific/Kiritimati"
		},
		"fix": {
			"schedule": "0 12 * * *",
			"function": "api/fix",
			"timezone": "Pacific/Kiritimati"
		},
		"overwrite": {
			"schedule": "5 12 * * *",
			"function": "api/overwrite",
			"timezone": "Pacific/Kiritimati"
		}
	},
	"functions": {
		"api/generate.ts": {
			"experimentalTriggers": [{ "type": "schedule/v1beta" }]
		},
		"api/fix.ts": {
			"experimentalTriggers": [{ "type": "schedule/v1beta" }]
		},
		"api/overwrite.ts": {
			"experimentalTriggers": [{ "type": "schedule/v1beta" }]
		}
	}
}
